# Icinga2 MCP
ICINGA_HOST=<your-icinga-host>
ICINGA_USER=<api-user>
ICINGA_PASSWORD=<your-api-password>
# Set to true when the Core API certificate is trusted.
ICINGA_VERIFY_SSL=false
# ICINGA_TRANSPORT=stdio
# ICINGA_MCP_HOST=127.0.0.1
# ICINGA_MCP_PORT=8092
# ICINGA_PLUGIN_CATALOG_PATH=/path/to/monitoring-plugins/check-plugins
# ICINGA_HISTORY__URL=https://monitoring.example/icingaweb2
# ICINGA_HISTORY__USER=<icinga-web-user>
# ICINGA_HISTORY__PASSWORD=<icinga-web-password>
# ICINGA_HISTORY__CA_BUNDLE=/path/to/ca.pem

# Director MCP
DIRECTOR_BASE_URL=https://<your-icinga-host>/director
DIRECTOR_USER=<your-icingaweb2-user>
DIRECTOR_PASSWORD=<your-icingaweb2-password>
# Set to true when the Director API certificate is trusted.
DIRECTOR_VERIFY_SSL=false
# Optional Director deployment preview
# DIRECTOR_ACTIVITY__SSH_TARGET=director-mcp-audit@director.example
# DIRECTOR_ACTIVITY__IDENTITY_FILE=/path/to/activity-reader-key
# DIRECTOR_ACTIVITY__KNOWN_HOSTS=/path/to/known_hosts
